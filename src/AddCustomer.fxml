<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="AddCustomerController" spacing="12" styleClass="form-pane">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="&#128100;  Add Customer" styleClass="section-label"/>

    <Label text="Customer ID"/>
    <TextField fx:id="idField" promptText="e.g. C001"/>

    <Label text="Name"/>
    <TextField fx:id="nameField" promptText="Full name"/>

    <Label text="Email"/>
    <TextField fx:id="emailField" promptText="name@example.com"/>

    <Button text="Save Customer" styleClass="action-button" onAction="#handleSaveCustomer"/>
</VBox>
