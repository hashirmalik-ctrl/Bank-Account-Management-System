<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="LoansController" spacing="12" styleClass="form-pane" prefWidth="700" prefHeight="560">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="&#127974;  Loans" styleClass="section-label"/>

    <Label text="Apply for a new loan" styleClass="subtitle-label"/>
    <HBox spacing="8">
        <TextField fx:id="customerIdField" promptText="Customer ID" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="amountField" promptText="Amount" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="interestRateField" promptText="Interest %" HBox.hgrow="ALWAYS"/>
        <Button text="Apply" styleClass="action-button" onAction="#handleApplyLoan"/>
    </HBox>

    <Label text="Make a repayment" styleClass="subtitle-label"/>
    <HBox spacing="8">
        <TextField fx:id="loanIdField" promptText="Loan ID" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="repaymentField" promptText="Payment Amount" HBox.hgrow="ALWAYS"/>
        <Button text="Pay" styleClass="gold-button" onAction="#handleRepayment"/>
    </HBox>

    <Label text="All Loans" styleClass="subtitle-label"/>
    <TableView fx:id="loansTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="loanIdColumn" text="Loan ID" prefWidth="110"/>
            <TableColumn fx:id="borrowerColumn" text="Borrower" prefWidth="120"/>
            <TableColumn fx:id="principalColumn" text="Principal" prefWidth="100"/>
            <TableColumn fx:id="totalPayableColumn" text="Total Payable" prefWidth="110"/>
            <TableColumn fx:id="remainingColumn" text="Remaining" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
