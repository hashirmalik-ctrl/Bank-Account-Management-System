<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ViewAccountsController" spacing="12" styleClass="form-pane" prefWidth="640" prefHeight="480">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="&#128203;  All Accounts" styleClass="section-label"/>

    <HBox spacing="8">
        <TextField fx:id="searchField" promptText="Search by account number or owner" HBox.hgrow="ALWAYS"/>
        <Button text="Search" styleClass="secondary-button" onAction="#handleSearch"/>
        <Button text="Sort by Balance" styleClass="secondary-button" onAction="#handleSortByBalance"/>
    </HBox>

    <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="accountNoColumn" text="Account No" prefWidth="130"/>
            <TableColumn fx:id="ownerColumn" text="Owner" prefWidth="140"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
            <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox spacing="8">
        <Button text="View Transaction History" styleClass="secondary-button" onAction="#handleViewHistory"/>
        <Button text="Add Interest (Savings)" styleClass="secondary-button" onAction="#handleAddInterest"/>
    </HBox>
</VBox>
