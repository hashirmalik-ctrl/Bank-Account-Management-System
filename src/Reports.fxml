<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ReportsController" spacing="12" styleClass="form-pane" prefWidth="560" prefHeight="480">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="&#128202;  Reports" styleClass="section-label"/>
    <Button text="&#128202;  Generate Summary Report" styleClass="gold-button" onAction="#handleGenerateSummaryReport"/>

    <TextArea fx:id="reportArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
</VBox>
